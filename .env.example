# ── Application database (Postgres 15+) ───────────────────────────────
# Dev default is embedded PGlite (no install needed); set this to use real Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/lcp

# ── Evosus / legacy source (on-prem SQL Server) ───────────────────────
# Read-only credentials. Never write to this server.
LEGACY_MSSQL_HOST=
LEGACY_MSSQL_PORT=1433
LEGACY_MSSQL_DATABASE=
LEGACY_MSSQL_USER=
LEGACY_MSSQL_PASSWORD=
LEGACY_MSSQL_ENCRYPT=true
LEGACY_MSSQL_TRUST_SERVER_CERT=true

# Where extracted legacy files land (gitignored, keep off shared drives)
ETL_DATA_DIR=./data

# ── Field encryption (ADR 0003) ───────────────────────────────────────
# Encrypts gate codes and lockbox codes. Required for any operation that
# touches them, including the legacy import.
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Back this up somewhere that is NOT this repository and NOT the database
# backup. If the key and the database are lost together, the gate codes are
# gone; if they are stored together, the encryption bought you nothing.
#
# PRODUCTION USES THE WRAPPED FORM BELOW, not this one. A raw key here sits in
# the same dashboard as DATABASE_URL, so one account compromise yields both
# halves — acceptable for staging, not for real gate codes.
LCP_FIELD_KEY=

# ── Field key, KMS-wrapped (ADR 0005) — the production form ────────────
# Mint and wrap the key once:
#
#   npm run key -- generate --key-id alias/lcp-field-key
#
# That prints the wrapped ciphertext for LCP_FIELD_KEY_WRAPPED and, once, the
# raw key for the SEALED OFFLINE COPY. Write the raw key on paper and seal it
# before closing the terminal — not in a password manager that syncs to the
# machine holding the database credentials.
#
# The app's IAM role needs kms:Decrypt on that key and nothing else.
# Check a configured key without printing it:  npm run key -- verify
# LCP_FIELD_KEY_WRAPPED=
# LCP_KMS_REGION=us-east-1
# LCP_KMS_KEY_ID=alias/lcp-field-key

# ── Database pool (serverless) ────────────────────────────────────────
# Point DATABASE_URL at Neon's POOLED endpoint (the `-pooler` host) in
# production. Pool size defaults to 1 on Vercel and 10 elsewhere; override
# only if you know why.
# DB_POOL_MAX=
# DB_IDLE_TIMEOUT=
# DB_CONNECT_TIMEOUT=


# ── Authentication — Clerk (ADR 0004) ─────────────────────────────────
# Without these, development on the embedded database runs as an
# auto-provisioned dev identity, and a deployment with DATABASE_URL set
# rejects every request (fails closed — see apps/web/lib/auth.ts).
#
# NOTE: Next.js middleware runs on the edge runtime and cannot read this
# repo-root file. For local Clerk testing put these in apps/web/.env.local;
# in production they come from the Vercel project environment.
#
# Keep the Clerk instance INVITE-ONLY. First sign-in auto-provisions a
# staff-level app_user row.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
