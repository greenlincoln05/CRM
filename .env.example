# ── Application database (Postgres 15+) ───────────────────────────────
# Dev default is embedded PGlite (no install needed); set this to use real Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/lcp

# ── Evosus / legacy source (on-prem SQL Server) ───────────────────────
# Read-only credentials. Never write to this server.
LEGACY_MSSQL_HOST=
LEGACY_MSSQL_PORT=1433
LEGACY_MSSQL_DATABASE=
LEGACY_MSSQL_USER=
LEGACY_MSSQL_PASSWORD=
LEGACY_MSSQL_ENCRYPT=true
LEGACY_MSSQL_TRUST_SERVER_CERT=true

# Where extracted legacy files land (gitignored, keep off shared drives)
ETL_DATA_DIR=./data
